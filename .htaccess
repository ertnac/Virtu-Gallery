# VirtuGallery Apache Configuration
DirectoryIndex index.php index.html

# Prevent directory listings
Options -Indexes

# Follow symlinks
Options +FollowSymLinks

# Security: Protect sensitive files and credentials
<FilesMatch "(\.env|\.git|\.db|\.sqlite|\.sql|php\.ini|composer\.(json|lock)|package\.(json|lock)|vercel\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Upload limits and PHP configurations
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
</IfModule>
